Options -MultiViews
RewriteEngine on

# JSON-LD content negotiation: SN-xxx -> passports/SN-xxx.jsonld
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(SN-[0-9]+)$ https://DPPIP.github.io/DPP-EUROTUBE/passports/$1.jsonld [R=303,L]

# HTML: SN-xxx -> passports/SN-xxx.html
RewriteRule ^(SN-[0-9]+)$ https://DPPIP.github.io/DPP-EUROTUBE/passports/$1.html [R=303,L]

# JSON-LD content negotiation: LOT-xxx -> batch/LOT-xxx.jsonld
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(LOT-[A-Za-z0-9-]+)$ https://DPPIP.github.io/DPP-EUROTUBE/batch/$1.jsonld [R=303,L]

# HTML: LOT-xxx -> batch/index.html?batch=LOT-xxx
RewriteRule ^(LOT-[A-Za-z0-9-]+)$ https://DPPIP.github.io/DPP-EUROTUBE/batch/index.html?batch=$1 [R=303,L]

# Fallback: redirect to main page
RewriteRule ^$ https://DPPIP.github.io/DPP-EUROTUBE/ [R=303,L]
